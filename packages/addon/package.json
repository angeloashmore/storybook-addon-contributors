{
  "name": "storybook-addon-component-contributors",
  "version": "0.0.0",
  "private": true,
  "description": "Storybook panel that shows who has worked on the current component, from local git history",
  "keywords": ["storybook-addon"],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./preset": "./dist/preset.js",
    "./manager": "./dist/manager.js",
    "./package.json": "./package.json"
  },
  "files": ["dist/**/*", "README.md", "*.js"],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch"
  },
  "bundler": {
    "managerEntries": ["src/manager.tsx"],
    "nodeEntries": ["src/preset.ts", "src/index.ts"]
  },
  "peerDependencies": {
    "storybook": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "react": "^19",
    "react-dom": "^19",
    "storybook": "10.6.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0"
  },
  "storybook": {
    "displayName": "Component Contributors"
  }
}
