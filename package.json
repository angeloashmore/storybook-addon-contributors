{
  "name": "storybook-addon-contributors",
  "version": "0.0.0",
  "description": "Find the right person to talk to about a component without leaving Storybook",
  "keywords": [
    "contributors",
    "git",
    "storybook-addon"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/angeloashmore/storybook-addon-contributors.git"
  },
  "workspaces": [
    "example"
  ],
  "files": [
    "src"
  ],
  "type": "module",
  "exports": {
    ".": "./src/preset.ts",
    "./preset": "./src/preset.ts",
    "./manager": "./src/manager.tsx",
    "./preview": "./src/preview.tsx"
  },
  "scripts": {
    "storybook": "npm run storybook -w example",
    "build-storybook": "npm run build-storybook -w example",
    "format": "oxfmt",
    "lint": "oxlint --deny-warnings",
    "types": "tsc",
    "unit": "vitest run",
    "test": "npm run lint && npm run types && npm run unit"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.0",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "oxfmt": "^0.70.0",
    "oxlint": "1.85.0",
    "playwright": "1.56.1",
    "storybook": "10.6.0",
    "typescript": "^5.9.3",
    "vitest": "5.0.2"
  },
  "peerDependencies": {
    "@storybook/addon-docs": "^10.0.0",
    "storybook": "^10.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
