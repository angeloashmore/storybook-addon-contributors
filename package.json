{
  "private": true,
  "type": "module",
  "scripts": {
    "fixture": "node example/scripts/generate-fixture.mjs",
    "dev": "npm run fixture && npm exec -w example -- storybook dev -p 6006",
    "build": "npm run fixture && npm exec -w example -- storybook build -o storybook-static",
    "test": "vitest run",
    "typecheck": "tsc",
    "evals": "vitest run --project evals --reporter=default --reporter=./evals/reporter.ts"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.283",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "playwright": "1.56.1",
    "storybook": "10.6.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  },
  "workspaces": [
    "packages/*",
    "example"
  ]
}
